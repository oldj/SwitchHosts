{
  "private": true,
  "name": "switchhosts",
  "version": "5.0.3-beta.2",
  "description": "Switch hosts quickly!",
  "homepage": "https://switchhosts.app",
  "license": "Apache-2.0",
  "scripts": {
    "pretest": "rimraf ./test/tmp",
    "test": "npm run test:all",
    "test:unit": "vitest --config ./vitest.config.mts --watch=false",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test:e2e": "playwright test",
    "test:all": "npm run typecheck && npm run test:unit && npm run test:rust && npm run test:e2e",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.{ts,tsx}\" \"e2e/**/*.{ts,js}\"",
    "lint:fix": "eslint \"src/**/*.{ts,tsx}\" \"e2e/**/*.{ts,js}\" --fix",
    "clean:dist": "rimraf ./dist/*",
    "clean:build": "rimraf ./build/*",
    "dev:renderer": "vite --config ./vite.render.config.mts",
    "build:renderer": "vite build --config ./vite.render.config.mts",
    "build:renderer:tauri": "node scripts/sync-tauri-version.mjs && vite build --config ./vite.render.config.mts --outDir ../../build-tauri --emptyOutDir",
    "build:universal-helper": "node scripts/bundle-universal-helper.mjs",
    "sort-lang": "node ./scripts/sort-lang.mjs",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:info": "tauri info",
    "version": "node scripts/sync-tauri-version.mjs && git add src/version.json src-tauri/tauri.conf.json src-tauri/Cargo.toml src-tauri/Cargo.lock"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "dayjs": "1.11.23",
    "lodash": "4.18.1",
    "tslib": "2.8.1",
    "uuid": "14.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@mantine/core": "^9.6.3",
    "@mantine/hooks": "^9.6.3",
    "@mantine/notifications": "^9.6.3",
    "@playwright/test": "^1.63.0",
    "@tabler/icons-react": "3.48.0",
    "@tauri-apps/api": "^2.12.1",
    "@tauri-apps/cli": "^2.12.1",
    "@testing-library/react": "^16.3.3",
    "@types/assert": "1.5.11",
    "@types/lodash": "4.17.25",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "ahooks": "3.10.0",
    "clsx": "2.1.1",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jotai": "3.0.1",
    "jsdom": "^30.1.2",
    "prettier": "3.9.9",
    "pretty-bytes": "7.2.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-icons": "5.7.0",
    "react-router": "8.4.0",
    "rimraf": "^6.1.3",
    "sass": "1.105.1",
    "smooth-scroll-into-view-if-needed": "2.0.2",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "8.3.2",
    "vitest": "^5.0.3"
  }
}
